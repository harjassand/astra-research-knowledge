{
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "previous",
    "fixture",
    "disclosure",
    "mode",
    "context",
    "model",
    "prompt_availability",
    "prompt_ref_ids",
    "output_ref_ids",
    "status",
    "resources",
    "advance",
    "matched_run_id",
    "refs",
    "next_obligation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "astra-research-workflow/1"},
    "id": {"type": "string", "pattern": "RW-[a-z0-9][a-z0-9-]{0,75}"},
    "version": {"type": "integer", "minimum": 1},
    "previous": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "fixture": {"type": "boolean"},
    "disclosure": {"type": "string", "const": "public"},
    "mode": {
      "type": "string",
      "enum": [
        "targeted_warm_continuation",
        "fresh_direction_retained_context",
        "new_instance",
        "source_intensive_multi_agent",
        "independent_selective_capital",
        "UNKNOWN"
      ]
    },
    "context": {
      "type": "object",
      "required": ["conversation_relation", "retained_context", "capital_access", "context_ref_ids"],
      "additionalProperties": false,
      "properties": {
        "conversation_relation": {"type": "string", "enum": ["same", "new", "UNKNOWN"]},
        "retained_context": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "capital_access": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "context_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "model_id", "immutable_version", "reasoning_effort"],
      "additionalProperties": false,
      "properties": {
        "provider": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "model_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "immutable_version": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "reasoning_effort": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "prompt_availability": {"type": "string", "enum": ["exact", "UNKNOWN"]},
    "prompt_ref_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
      "minItems": 0,
      "uniqueItems": true
    },
    "output_ref_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
      "minItems": 0,
      "uniqueItems": true
    },
    "status": {"type": "string", "enum": ["completed", "failed", "timed_out", "aborted", "missing"]},
    "resources": {
      "type": "object",
      "required": [
        "reported_inference_seconds",
        "reported_duration_ref_ids",
        "usage",
        "usage_receipt_ref_ids",
        "worker_invocations",
        "worker_receipt_ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "reported_inference_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "reported_duration_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "usage": {
          "type": "object",
          "required": [
            "context_tokens",
            "input_tokens_total",
            "output_tokens_total",
            "model_calls",
            "tool_calls",
            "wall_seconds",
            "cpu_seconds",
            "gpu_seconds",
            "compute_usd",
            "parallel_workers"
          ],
          "additionalProperties": false,
          "properties": {
            "context_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "input_tokens_total": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "output_tokens_total": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "model_calls": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "tool_calls": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
            "wall_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
            "cpu_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
            "gpu_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
            "compute_usd": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
            "parallel_workers": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
          }
        },
        "usage_receipt_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "worker_invocations": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "worker_receipt_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "advance": {
      "type": "object",
      "required": ["kind", "summary", "scientific_status", "verification", "evidence_ref_ids", "verification_receipt"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["mathematical", "technological", "negative", "none", "UNKNOWN"]},
        "summary": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "scientific_status": {"type": "string", "minLength": 1},
        "verification": {
          "type": "string",
          "enum": ["unassessed", "producer_reported", "internal_check", "independent_receipt", "experimental_receipt"]
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "verification_receipt": {
          "anyOf": [
            {
              "type": "object",
              "required": ["checked_output_sha256", "independence_attested", "scope", "ref_ids"],
              "additionalProperties": false,
              "properties": {
                "checked_output_sha256": {"type": "array", "items": {"type": "string", "pattern": "[0-9a-f]{64}"}, "minItems": 1, "uniqueItems": true},
                "independence_attested": {"type": "boolean"},
                "scope": {"type": "string", "minLength": 1},
                "ref_ids": {
                  "type": "array",
                  "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "matched_run_id": {"anyOf": [{"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"}, {"type": "null"}]},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 0},
    "next_obligation": {"type": "string", "minLength": 1}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["id", "path", "sha256", "lines", "source_revision", "source_id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "lines": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
            {"type": "null"}
          ]
        },
        "source_revision": {"anyOf": [{"type": "string", "pattern": "[0-9a-f]{40}"}, {"type": "null"}]},
        "source_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "status": {"type": "string", "minLength": 1}
      }
    }
  },
  "description": "Observational trace only. No causal prompting advantage or independent truth is certified."
}
