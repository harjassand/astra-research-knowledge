{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra supporting-lemma atlas record v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "topics",
    "claim_ids",
    "source",
    "statement",
    "interface",
    "proof_mechanism",
    "depends_on",
    "obstructions",
    "potential_uses",
    "generalisations",
    "review",
    "search_terms"
  ],
  "properties": {
    "schema": {
      "const": "astra.lemma_atlas.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^LA[0-9]{3}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "lemma",
        "corollary",
        "proof_mechanism",
        "counterexample"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "path",
          "sha256",
          "object_path",
          "version",
          "source_kind",
          "available",
          "locators",
          "web_page"
        ],
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "object_path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "authored_proof_module",
              "locally_captured_release_source"
            ]
          },
          "available": {
            "enum": [
              "full_local_exact_utf8"
            ]
          },
          "locators": {
            "type": "object",
            "required": [
              "lines",
              "labels"
            ],
            "properties": {
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "web_page": {
            "type": "string"
          }
        }
      }
    },
    "statement": {
      "type": "object",
      "required": [
        "quantifiers",
        "assertion",
        "assumptions"
      ],
      "properties": {
        "quantifiers": {
          "type": "string"
        },
        "assertion": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "precision",
        "costs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "precision": {
          "type": "string"
        },
        "costs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proof_mechanism": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "obstructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "potential_uses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "transfer_gate",
          "status"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "transfer_gate": {
            "type": "string"
          },
          "status": {
            "const": "speculative_not_established"
          }
        }
      }
    },
    "generalisations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hypothesis",
          "status"
        ],
        "properties": {
          "hypothesis": {
            "type": "string"
          },
          "status": {
            "const": "unproved_not_exported"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "ingestion",
        "proof_reconstruction",
        "source_reported",
        "external_correctness",
        "historical_priority",
        "status_upgrade"
      ],
      "properties": {
        "ingestion": {
          "enum": [
            "detailed_extraction",
            "proof_reconstruction"
          ]
        },
        "proof_reconstruction": {
          "type": "boolean"
        },
        "source_reported": {
          "type": "string"
        },
        "external_correctness": {
          "type": "string"
        },
        "historical_priority": {
          "type": "string"
        },
        "status_upgrade": {
          "type": "boolean"
        }
      }
    },
    "search_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "description": "Line locators use exact SHA-pinned source text. Schema validity and hash checks are retrieval/provenance evidence, not proof validity. proof_reconstruction=true requires a separate scoped receipt; source-reported internal audits alone do not suffice."
}
