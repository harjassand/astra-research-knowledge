{
  "schema": "canonical-cdf-factored-algebraic-dual-v1",
  "source_witness": "maximum_witness.json",
  "root_selectors": "r=node1; x=node2; z_i=node i for i=3..64; S=node65",
  "degree_limit": 127,
  "h": "x-r",
  "B(t)": "((S-t)/(S-r))*product(i=3..64,((t-z_i)/(r-z_i))^2)",
  "A": "1/(S-r)+2*sum(i=3..64,1/(z_i-r))",
  "T": "1/B(x)",
  "C": "(T-1-A*h)/h^2",
  "minorant": "((x-t)/h)*B(t)*(1+(A+1/h)*(t-r))",
  "majorant": "B(t)*(1+A*(t-r)+C*(t-r)^2)",
  "identity_majorant_minus_minorant": "((S-t)/(S-x))*((t-r)/(x-r))^2*product(i=3..64,((t-z_i)/(x-z_i))^2)",
  "inequalities": "minorant <= indicator([-S,x)) <= indicator([-S,x]) <= majorant",
  "proof": "RESULT.txt: reciprocal-product derivatives, strict convexity, Hermite remainder",
  "dual_values": "L(minorant)=weight1; L(majorant)=weight1+weight2"
}
