+def edit_range_in_file(path_obj: Path, start_line: int, end_line: int, replacement_text: str) -> str:
+    """Edit a specific range of lines in a file."""
+    try:
+        # Read all lines from the file
+        content = read_file(path_obj)
+        lines = content.splitlines()
+
+        # Validate line numbers
+        if start_line < 1 or start_line > len(lines) + 1:
+            raise ValueError(f"Start line {start_line} is out of range (1-{len(lines)+1})")
+        if end_line < start_line:
+            raise ValueError(f"End line {end_line} must be greater than or equal to start line {start_line}")
+        if end_line > len(lines):
+            raise ValueError(f"End line {end_line} is out of range (1-{len(lines)})")
+
+        # Convert to 0-based indexing for list operations
+        start_idx = start_line - 1
+        end_idx = end_line
+
+        # Split replacement text into lines
+        replacement_lines = replacement_text.splitlines()
+
+        # Create the new content by replacing the specified range
+        new_lines = lines[:start_idx] + replacement_lines + lines[end_idx:]
+        new_content = "\n".join(new_lines)
+
+        # Add final newline if original content had one
+        if content.endswith("\n"):
+            new_content += "\n"
+
+        # Write the modified content back to the file
+        write_file(path_obj, new_content)
