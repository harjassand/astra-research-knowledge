+import pytest
+from tools.ast_edit import tool_function
+
+def normalize_whitespace(text):
+    """Normalize whitespace and quotes for comparison."""
+    return ' '.join(text.split())
+
+def test_simple_transformation():
+    source = '''
+def example(x, y):
+    return x + y
+'''
+    
+    transforms = [
+        {
+            "type": "add_parameter",
+            "target": "example",
+            "parameters": {"name": "z", "default": 0}
+        }
+    ]
+    
+    result = tool_function(source, transforms)
+    assert normalize_whitespace('def example(x, y, z=0):') in normalize_whitespace(result)
+    assert 'return x + y' in result
+
+def test_function_wrapper():
+    source = '''
+def calculate(a, b):
+    return a * b
+'''
+    
+    transforms = [
+        {
+            "type": "wrap_function",
+            "target": "calculate",
+            "parameters": {
+                "code": """
+def calculate(a, b):
+    print('Starting calculation...')
+    pass  # Original code goes here
+    print('Calculation complete!')
+    return result
+"""
+            }
+        }
+    ]
+    
+    result = tool_function(source, transforms)
+    assert "print('Starting calculation...')" in result
+    assert 'return a * b' in result
+    assert "print('Calculation complete!')" in result
+
+def test_add_decorator():
+    source = '''
+def process():
+    pass
+'''
+    
+    transforms = [
+        {
+            "type": "add_decorator",
+            "target": "process",
+            "parameters": {"decorator": "my_decorator"}
+        }
+    ]
+    
+    result = tool_function(source, transforms)
+    assert '@my_decorator' in result
+
+def test_insert_code():
+    source = '''
+def handler():
+    x = 1
+    y = 2
+'''
+    
+    transforms = [
+        {
+            "type": "insert_code",
+            "target": "handler",
+            "parameters": {
+                "position": "start",
+                "code": "logger.info('Starting handler')"
+            }
+        }
+    ]
+    
+    result = tool_function(source, transforms)
+    assert "logger.info('Starting handler')" in result
+    assert 'x = 1' in result
+    assert 'y = 2' in result
+
+def test_multiple_transformations():
+    source = '''
+def compute(x):
+    return x * 2
+'''
+    
+    transforms = [
+        {
+            "type": "add_parameter",
+            "target": "compute",
+            "parameters": {"name": "factor", "default": 1}
+        },
+        {
+            "type": "insert_code",
+            "target": "compute",
+            "parameters": {
+                "position": "start",
+                "code": "if factor <= 0: raise ValueError('Factor must be positive')"
+            }
+        }
+    ]
+    
+    result = tool_function(source, transforms)
+    assert normalize_whitespace('def compute(x, factor=1):') in normalize_whitespace(result)
+    assert "raise ValueError('Factor must be positive')" in result
+    assert 'return x * 2' in result
+
+def test_invalid_source_code():
+    source = '''
+def bad_syntax(
+    return 42
+'''
+    
+    result = tool_function(source)
+    assert 'Error:' in result
+
+def test_no_transformations():
+    source = '''
+def unchanged(a, b):
+    return a + b
+'''
+    
+    result = tool_function(source)
+    assert 'def unchanged(a, b):' in result
+    assert 'return a + b' in result
