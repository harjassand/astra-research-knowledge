N33Affine.exists_full_affine_family (m : Nat) (a b : Real) (E : (Fin m → Real) → Real) :
  @LE.le.{0} Real Real.instLE a b →
    (∀ (r : Fin m → Real),
        @N33Affine.InCube m a b r →
          @LT.lt.{0} Real Real.instLT (@OfNat.ofNat.{0} Real (nat_lit 0) (@Zero.toOfNat0.{0} Real Real.instZero))
            (E r)) →
      @Exists.{2} (N33Affine.BoxFamily m a b) fun (F : N33Affine.BoxFamily m a b) =>
        And (@N33Affine.FamilyLittleOAt m a b F a)
          (@N33Affine.FullApproximation m a b E (@N33Affine.BoxFamily.family m a b F))
'N33Affine.exists_full_affine_family' depends on axioms: [propext, Classical.choice, Quot.sound]
'N33Affine.exists_local_window_of_lower_dimensions' depends on axioms: [propext, Classical.choice, Quot.sound]
