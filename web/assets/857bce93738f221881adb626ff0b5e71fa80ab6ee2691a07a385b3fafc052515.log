N33Dynamics.cappedScaleMagnitude_succ {A P : ℝ} (hP : 0 < P) (n : ℕ) :
  N33Dynamics.cappedScaleMagnitude A P (n + 1) = max (N33Dynamics.cappedScaleMagnitude A P n / 2) P
N33Dynamics.cappedSqrtScale_succ {A P : ℝ} (hP : 0 < P) (n : ℕ) :
  N33Dynamics.cappedSqrtScale A P (n + 1) = min (√(N33Dynamics.cappedSqrtScale A P n)) (Real.exp (-P))
N33Dynamics.permanenceScale_zero {h₀ hP : ℝ} (hh₀ : 0 < h₀) (h₀P : h₀ ≤ hP) : N33Dynamics.permanenceScale h₀ hP 0 = h₀
N33Dynamics.permanenceScale_cap {h₀ hP : ℝ} (hhP : 0 < hP) (hh₀ : 0 < h₀) (hhP1 : hP < 1) (h₀P : h₀ ≤ hP) :
  ∃ N, N33Dynamics.permanenceScale h₀ hP N = hP
N33Dynamics.permanenceScale_succ {h₀ hP : ℝ} (hhP : 0 < hP) (hhP1 : hP < 1) (n : ℕ) :
  N33Dynamics.permanenceScale h₀ hP (n + 1) = min (√(N33Dynamics.permanenceScale h₀ hP n)) hP
N33Dynamics.scaleBox_mono {d : ℕ} {hSmall hBig : ℝ} (hSmallPos : 0 < hSmall) (hSmallBig : hSmall ≤ hBig)
  {x : Fin d → ℝ} : N33Dynamics.ScaleBox hBig x → N33Dynamics.ScaleBox hSmall x
N33Dynamics.plateau_subset_nextScaleBox {d : ℕ} {h hNext : ℝ} (hNextPos : 0 < hNext) (hNextSqrt : hNext ≤ √h)
  {K : Set (Fin d → ℝ)} (hK : K ⊆ {x | N33Dynamics.ScaleBox (√h) x}) : K ⊆ {x | N33Dynamics.ScaleBox hNext x}
N33Dynamics.finite_absorber_chain {N : ℕ} (W : ℕ → ℝ) (P : ℕ → ℝ → Prop) (hbase : P 0 0)
  (hstep : ∀ n < N, ∀ (s : ℝ), P n s → ∃ t, s ≤ t ∧ t ≤ s + W n ∧ P (n + 1) t) :
  ∃ t, 0 ≤ t ∧ t ≤ ∑ n ∈ Finset.range N, W n ∧ P N t
N33Dynamics.permanenceScale_absorber_entry {h₀ hP : ℝ} (hhP : 0 < hP) (hh₀ : 0 < h₀) (hhP1 : hP < 1) (h₀P : h₀ ≤ hP)
  (W : ℕ → ℝ) (K : ℝ → ℝ → Prop) (hbase : K h₀ 0)
  (hstep :
    ∀ (n : ℕ) (s : ℝ),
      K (N33Dynamics.permanenceScale h₀ hP n) s →
        ∃ t, s ≤ t ∧ t ≤ s + W n ∧ K (N33Dynamics.permanenceScale h₀ hP (n + 1)) t) :
  ∃ N t, N33Dynamics.permanenceScale h₀ hP N = hP ∧ 0 ≤ t ∧ t ≤ ∑ n ∈ Finset.range N, W n ∧ K hP t
