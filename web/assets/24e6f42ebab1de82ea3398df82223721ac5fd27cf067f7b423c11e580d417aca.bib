@misc{mancinskaGappreservingReductionsREcompleteness2025,
  title = {Gap-Preserving Reductions and {{RE-completeness}} of Independent Set Games},
  author = {Man{\v c}inska, Laura and Spaas, Pieter and Spirig, Taro and Vernooij, Matthijs},
  year = {2025},
