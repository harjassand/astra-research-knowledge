  abstract = {The class \${\textbackslash}mathsf\{MIP\}{\textasciicircum}*\$ is the set of languages decidable by multiprover interactive proofs with quantum entangled provers. It was recently shown by Ji, Natarajan, Vidick, Wright and Yuen that \${\textbackslash}mathsf\{MIP\}{\textasciicircum}*\$ is equal to \${\textbackslash}mathsf\{RE\}\$, the set of recursively enumerable languages. In particular this shows that the complexity of approximating the quantum value of a non-local game \$G\$ is equivalent to the complexity of the Halting problem. In this paper we investigate the complexity of deciding whether the quantum value of a non-local game \$G\$ is exactly \$1\$. This problem corresponds to a complexity class that we call zero gap \${\textbackslash}mathsf\{MIP\}{\textasciicircum}*\$, denoted by \${\textbackslash}mathsf\{MIP\}{\textasciicircum}*\_0\$, where there is no promise gap between the verifier's acceptance probabilities in the YES and NO cases. We prove that \${\textbackslash}mathsf\{MIP\}{\textasciicircum}*\_0\$ extends beyond the first level of the arithmetical hierarchy (which includes \${\textbackslash}mathsf\{RE\}\$ and its complement \${\textbackslash}mathsf\{coRE\}\$), and in fact is equal to \${\textbackslash}Pi\_2{\textasciicircum}0\$, the class of languages that can be decided by quantified formulas of the form \${\textbackslash}forall y {\textbackslash}, {\textbackslash}exists z {\textbackslash}, R(x,y,z)\$. Combined with the previously known result that \${\textbackslash}mathsf\{MIP\}{\textasciicircum}\{co\}\_0\$ (the commuting operator variant of \${\textbackslash}mathsf\{MIP\}{\textasciicircum}*\_0\$) is equal to \${\textbackslash}mathsf\{coRE\}\$, our result further highlights the fascinating connection between various models of quantum multiprover interactive proofs and different classes in computability theory.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computational Complexity,Quantum Physics},
  file = {C\:\\Users\\Randy\\Zotero\\storage\\Y7NH3IUX\\Mousavi et al. - 2020 - On the complexity of zero gap MIP.pdf;C\:\\Users\\Randy\\Zotero\\storage\\A4ME98GA\\2002.html}
