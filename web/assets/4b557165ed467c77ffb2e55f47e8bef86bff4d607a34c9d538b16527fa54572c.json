{
  "model": "Goldbeter-Koshland reversible covalent modification cycle, normalized MM reduction",
  "source": "Goldbeter and Koshland, PNAS 78(11), 6840-6844 (1981), doi:10.1073/pnas.78.11.6840, Fig. 5 / Eq. 15",
  "normalization": {
    "coordinates": ["W/WT", "W*/WT"],
    "WT_uM": "100",
    "K1_Km1_over_WT": "1/100",
    "K2_Km2_over_WT": "1/100",
    "V2_uM_per_s": "10",
    "V1_over_V2": "6/5",
    "V1_uM_per_s": "12",
    "V1_over_WT_per_s": "3/25",
    "V2_over_WT_per_s": "1/10",
    "parameter_status": "Fig. 5 illustrative simulation point/end-point; not an experimental confidence interval or biological admissible-set bound"
  },
  "state_invariant": "W + W* = 1",
  "edges": [
    {
      "name": "kinase_forward_W_to_Wstar",
      "nu": ["-1", "1"],
      "P": [{"exp": ["1", "0"], "coef": "3/25"}],
      "Q": [
        {"exp": ["0", "0"], "coef": "1/100"},
        {"exp": ["1", "0"], "coef": "1"}
      ]
    },
    {
      "name": "phosphatase_reverse_Wstar_to_W",
      "nu": ["1", "-1"],
      "P": [{"exp": ["0", "1"], "coef": "1/10"}],
      "Q": [
        {"exp": ["0", "0"], "coef": "1/100"},
        {"exp": ["0", "1"], "coef": "1"}
      ]
    }
  ]
}
