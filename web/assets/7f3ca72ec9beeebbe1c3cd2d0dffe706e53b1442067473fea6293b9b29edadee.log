'rpow_ratio_tendsto_zero_of_lt' depends on axioms: [propext, Classical.choice, Quot.sound]
'rpow_ratio_tendsto_atTop_of_lt' depends on axioms: [propext, Classical.choice, Quot.sound]
'no_eventually_le_of_rpow_ratio_atTop' depends on axioms: [propext, Classical.choice, Quot.sound]
@rpow_ratio_tendsto_zero_of_lt : ∀ {h p : ℕ → ℝ} {p₀ q : ℝ},
  Filter.Tendsto h Filter.atTop (nhdsWithin 0 (Set.Ioi 0)) →
    Filter.Tendsto p Filter.atTop (nhds p₀) →
      q < p₀ → Filter.Tendsto (fun n => (h n).rpow (p n) / (h n).rpow q) Filter.atTop (nhds 0)
@rpow_ratio_tendsto_atTop_of_lt : ∀ {h p : ℕ → ℝ} {p₀ q : ℝ},
  Filter.Tendsto h Filter.atTop (nhdsWithin 0 (Set.Ioi 0)) →
    Filter.Tendsto p Filter.atTop (nhds p₀) →
      p₀ < q → Filter.Tendsto (fun n => (h n).rpow (p n) / (h n).rpow q) Filter.atTop Filter.atTop
@no_eventually_le_of_rpow_ratio_atTop : ∀ {h p : ℕ → ℝ} {p₀ q c : ℝ} {bump : ℝ → ℝ},
  Filter.Tendsto h Filter.atTop (nhdsWithin 0 (Set.Ioi 0)) →
    Filter.Tendsto p Filter.atTop (nhds p₀) →
      p₀ < q →
        0 < c →
          (bump =o[nhdsWithin 0 (Set.Ioi 0)] fun x => x.rpow q) →
            ¬∀ᶠ (n : ℕ) in Filter.atTop, c * (h n).rpow (p n) + bump (h n) ≤ (h n).rpow q
