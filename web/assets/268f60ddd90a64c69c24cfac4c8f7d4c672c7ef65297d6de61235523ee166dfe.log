WeightedDrift.weighted_drift_strict {d m : ℕ} (D : WeightedDrift.ReactionDiagram d m)
  (hEndo : WeightedDrift.AllEndotactic D) (F : N33Affine.BoxFamily d (-1) 1) (hAct : ℝ) (hActLtOne : hAct < 1)
  (hActivity : WeightedDrift.ActivityMargin D F hAct) (h : ℝ) (hh : 0 < h) (hhAct : h < hAct) (p : WeightedDrift.Vec d)
  (hp : WeightedDrift.inExponentBox p) (j : F.family.Index) (hactive : N33Affine.Active F.family.label j h p) (κ K : ℝ)
  (hκ : 0 < κ) (hκK : κ ≤ K) (k : Fin m → ℝ) (hk : ∀ (e : Fin m), κ ≤ k e ∧ k e ≤ K)
  (hsmall :
    K * WeightedDrift.reactionBudget D * h.rpow (WeightedDrift.slopeMargin D F) ≤ κ * WeightedDrift.slopeMargin D F)
  (hnotPerp : ¬WeightedDrift.StoichPerp D (F.family.label j).slope) :
  κ * WeightedDrift.slopeMargin D F * h.rpow (WeightedDrift.sourceBudget D) ≤
    WeightedDrift.dot (F.family.label j).slope (WeightedDrift.reactionField D k (WeightedDrift.scalePoint h p))
'WeightedDrift.weighted_drift_strict' depends on axioms: [propext, Classical.choice, Quot.sound]
WeightedDrift.projected_drift_nonneg_of_perp {d m : ℕ} (D : WeightedDrift.ReactionDiagram d m) (r : WeightedDrift.Vec d)
  (k : Fin m → ℝ) (x : WeightedDrift.Vec d) (hperp : WeightedDrift.StoichPerp D r) :
  0 ≤ WeightedDrift.dot r (WeightedDrift.reactionField D k x)
'WeightedDrift.projected_drift_nonneg_of_perp' depends on axioms: [propext, Classical.choice, Quot.sound]
WeightedDrift.exists_activity_margin {d m : ℕ} (D : WeightedDrift.ReactionDiagram d m)
  (F : N33Affine.BoxFamily d (-1) 1)
  (hFull : N33Affine.FullApproximation (-1) 1 (WeightedDrift.pointTolerance D) F.family) :
  ∃ hAct, 0 < hAct ∧ hAct < 1 ∧ WeightedDrift.ActivityMargin D F hAct
'WeightedDrift.exists_activity_margin' depends on axioms: [propext, Classical.choice, Quot.sound]
