  "edges": [
    {
      "composition": "N736 extends stationary/calibrated closure-response navigation to a bounded-rate frozen-history predictor on the deployed controller occupation law. It reconstructs acquisition under actual intervention products, changes the certification target to whole visible paths and retains finite/noisy costs. It neither upgrades N713 nor removes its kinetic-access obstructions; no theorem dependency or invalidation is inferred.",
      "from": "N736-occupation-whole-visible-path-certificate-and-conditional-variance-barrier",
      "kind": "material_update",
      "raw_kind": "source_reported_scoped_interface_extension",
      "source": "EL intake",
      "to": "N713-active-response-closure-certificate-and-kinetic-access-obstruction"
    },
    {
      "composition": "N736 continues the heterogeneous product-gain/nonstationary acquisition interface of N718, retaining simultaneous product semantics and selective neutrality or all-event sensing. Fresh reset/random-stop moments certify a sufficient on-policy whole-path residual, not all good predictors. The new conditional-variance barrier targets stronger posterior information; same-state copies are not independent posterior replicas. N718 source, correctness status and gates remain intact.",
      "from": "N736-occupation-whole-visible-path-certificate-and-conditional-variance-barrier",
