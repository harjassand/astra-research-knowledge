{"status":"OK","data":{"id":265555,"identifier":"3.FEEHJO","persistentUrl":"https://doi.org/10.17617/3.FEEHJO","protocol":"doi","authority":"10.17617","separator":"/","publisher":"Edmond","publicationDate":"2025-06-12","storageIdentifier":"54://10.17617/3.FEEHJO","effectiveDatasetFileCountLimit":500,"datasetFileUploadsAvailable":495,"datasetType":"dataset","locks":[],"latestVersion":{"id":2240,"datasetId":265555,"datasetPersistentId":"doi:10.17617/3.FEEHJO","datasetType":"dataset","storageIdentifier":"54://10.17617/3.FEEHJO","versionNumber":2,"internalVersionNumber":5,"versionMinorNumber":0,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","lastUpdateTime":"2025-07-29T14:27:46Z","releaseTime":"2025-07-29T14:27:46Z","createTime":"2025-07-17T14:11:25Z","publicationDate":"2025-06-12","citationDate":"2025-06-12","effectiveDatasetFileCountLimit":500,"datasetFileUploadsAvailable":495,"license":{"name":"CC0 1.0","uri":"http://creativecommons.org/publicdomain/zero/1.0","iconUri":"https:///assets.mpdl.mpg.de/licensebuttons.net/p/zero/1.0/88x31.png","rightsIdentifier":"CC0-1.0","rightsIdentifierScheme":"SPDX","schemeUri":"https://spdx.org/licenses/","languageCode":"en"},"fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Predicting Electrolyzer Performance under Forced Periodic Operation using Nonlinear Frequency Response Method"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Milicic, Tamara"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0002-3227-0852"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Max Planck Institute for Dynamics of Complex Technical Systems"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/030h7k016"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Electrochemical Energy Conversion"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Puteanus, Simon"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0003-2344-6147"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"TU Dresden"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/042aqky30"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Institute of Electrical Power Engineering"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Xenia Becker"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"TU Dresden"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/042aqky30"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Steffen Bernet"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"TU Dresden"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/042aqky30"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Institute of Electrical Power Engineering"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Vidakovic-Koch, Tanja"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0003-3896-3585"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Max Planck Institute for Dynamics of Complex Technical Systems"},"authorAffiliationId":{"typeName":"authorAffiliationId","multiple":false,"typeClass":"primitive","value":"https://ror.org/030h7k016"},"authorAffiliationDepartment":{"typeName":"authorAffiliationDepartment","multiple":false,"typeClass":"primitive","value":"Electrochemical Energy Conversion"}}]},{"typeName":"studyType","multiple":true,"typeClass":"controlledVocabulary","value":["experimental","simulation/modelling"]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Industrial-scale electrolyzers are supplied by power converters with a mixture of DC current and superimposed current ripple. Therefore, electrolyzers are inevitably operated in a forced periodic regime. On the other hand, pulsed electrolysis, as a type of forced periodic operation, emerged as an attractive process intensification strategy. While the negative impact of the current ripple on the electrolyzer performance was reported, the positive impact of pulsed electrolysis was claimed. However, since both regimes are types of forced periodic operation, a similar effect is expected. To clarify this, we suggest the nonlinear frequency response (NFR) method for evaluation of the performance of a proton exchange membrane water electrolyzer (PEMWE) in forced periodic operation.\nThe NFR method demonstrates a voltage decrease and power consumption increase during forced periodic operation of PEMWE in comparison to the steady-state operation, agreeing remarkably well with experiments and numerical simulations. Furthermore, the NFR method reveals that the voltage decrease is a consequence of the system's nonlinear kinetics, and the power requirements are influenced by both linear and nonlinear phenomena. Linear contributions tend to increase power requirements, while nonlinear contributions decrease them. However, regardless of the operating conditions, linear contributions prevail, leading to increased power consumption during forced periodic operation. At the usual operating current densities, ohmic contributions dominate the PEMWE power increase.\nOverall, the NFR method proves advantageous for analyzing forced periodic operations, providing an analytical tool to calculate the electrolyzer's losses during such conditions and guide system design, especially of the supplying power converter."}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Chemistry"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"water electrolysis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"power consumption"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"pulsed electrolysis"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"forced periodic operation"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"nonlinear frequecy response (NFR)"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"current ripple"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"grantNumber","multiple":true,"typeClass":"compound","value":[{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"Federal Ministry of Education and Research"},"grantNumberValue":{"typeName":"grantNumberValue","multiple":false,"typeClass":"primitive","value":"H2Giga QT6.1 HyLeiT"}},{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"International Max Planck Research School for Advanced Meth- ods in Process and Systems Engineering (IMPRS ProEng)"}},{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"Ministry for Science, Energy, Climate Protec- tion, and the Environment of the State of Saxony-Anhalt"},"grantNumberValue":{"typeName":"grantNumberValue","multiple":false,"typeClass":"primitive","value":"Research Initiative SmartProSys: Intelligent Process Systems for the Sustainable Production of Chemicals"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Milicic, Tamara"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2025-02-28"},{"typeName":"software","multiple":true,"typeClass":"compound","value":[{"softwareName":{"typeName":"softwareName","multiple":false,"typeClass":"primitive","value":"Matlab"},"softwareVersion":{"typeName":"softwareVersion","multiple":false,"typeClass":"primitive","value":"R2019b, R2022a"}}]},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"primitive","value":"The nonlinear frequency response method for the diagnosis of PEM water electrolyzer performance"},"publicationURL":{"typeName":"publicationURL","multiple":false,"typeClass":"primitive","value":"https://doi.org/10.1016/j.cej.2024.153889"}}]},{"typeName":"relatedDatasets","multiple":true,"typeClass":"primitive","value":["https://doi.org/10.17617/3.I0ECY9"]}]}},"files":[{"label":"Experimental results.zip","restricted":false,"version":1,"datasetVersionId":2240,"dataFile":{"id":274457,"persistentId":"","filename":"Experimental results.zip","contentType":"application/zip","friendlyType":"ZIP Archive","filesize":98824,"storageIdentifier":"54://edmond-objstor-prod:1955ba1aeef-1b766229dc04","rootDataFileId":-1,"md5":"1f7125da4dfbff71e63d