olls", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14592760, "full_name": "Emily Greeves", "first_name": "Emily", "last_name": "Greeves", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1297401, "full_name": "David M. Barber", "first_name": "David M.", "last_name": "Barber", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 6880802, "full_name": "Julius Hillenbrand", "first_name": "Julius", "last_name": "Hillenbrand", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 5487245, "full_name": "Giulio Volpin", "first_name": "Giulio", "last_name": "Volpin", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 722008, "full_name": "Klavs F. Jensen", "first_name": "Klavs F.", "last_name": "Jensen", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/dataset/Open-Source_Chromatographic_Data_Analysis_for_Reaction_Optimization_and_Screening/22061158", "download_disabled": false, "description": "Automation and digitalization\nsolutions in the field of small molecule\nsynthesis face new challenges for chemical reaction analysis, especially\nin the field of high-performance liquid chromatography (HPLC). Chromatographic\ndata remains locked in vendors\u2019 hardware and software components,\nlimiting their potential in automated workflows and data science applications.\nIn this work, we present an open-source Python project called MOCCA\nfor the analysis of HPLC\u2013DAD (photodiode array detector) raw\ndata. MOCCA provides a comprehensive set of data analysis features,\nincluding an automated peak deconvolution routine of known signals,\neven if overlapped with signals of unexpected impurities or side products.\nWe highlight the broad applicability of MOCCA in four studies: (i)\na simulation study to validate MOCCA\u2019s data analysis features;\n(ii) a reaction kinetics study on a Knoevenagel condensation reaction\ndemonstrating MOCCA\u2019s peak deconvolution feature; (iii) a closed-loop\noptimization study for the alkylation of 2-pyridone without human\ncontrol during data analysis; (iv) a well plate screening of categorical\nreaction parameters for a novel palladium-catalyzed cyanation of aryl\nhalides employing <i>O</i>-protected cyanohydrins. By publishing\nMOCCA as a Python package with this work, we envision an open-source\ncommunity project for chromatographic data analysis with the potential\nof further advancing its scope and capabilities.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 27748130, "created_date": "2023-02-09T17:35:57Z", "modified_date": "2023-06-21T04:34:00Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["vendors \u2019 hardware", "source community project", "photodiode array detector", "performance liquid chromatography", "peak deconvolution feature", "aryl halides employing", ">- protected cyanohydrins", "categorical reaction parameters", "data science applications", "well plate screening", "hplc \u2013 dad", "reaction kinetics study", "loop optimization study", "chemical reaction analysis", "validate mocca \u2019", "data analysis features", "chromatographic data analysis", "reaction optimization", "data analysis", "simulation study", "raw data", "screening automation", "hplc ).", "unexpected impurities", "software components", "side products", "python package", "publishing mocca", "novel palladium", "mocca provides", "four studies", "digitalization solutions", "comprehensive set", "catalyzed cyanation", "broad applicability", "automated workflows"], "keywords": ["vendors \u2019 hardware", "source community project", "photodiode array detector", "performance liquid chromatography", "peak deconvolution feature", "aryl halides employing", ">- protected cyan