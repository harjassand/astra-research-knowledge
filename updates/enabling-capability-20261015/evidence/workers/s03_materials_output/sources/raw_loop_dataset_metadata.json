e","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":true,"typeClass":"primitive","value":["0000-0001-7012-930X"]}}]},{"typeName":"contributor","multiple":true,"typeClass":"compound","value":[{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Nykiel, Anna"},"contributorAffiliation":{"typeName":"contributorAffiliation","multiple":false,"typeClass":"primitive","value":"The Henryk Niewodniczański Institute of Nuclear Physics Polish Academy of Sciences"},"contributorIdScheme":{"typeName":"contributorIdScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"contributorId":{"typeName":"contributorId","multiple":false,"typeClass":"primitive","value":"0000-0003-1373-1980"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Maziarz, Wojciech"},"contributorAffiliation":{"typeName":"contributorAffiliation","multiple":false,"typeClass":"primitive","value":"Institute of Metallurgy and Materials Science"},"contributorIdScheme":{"typeName":"contributorIdScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"contributorId":{"typeName":"contributorId","multiple":false,"typeClass":"primitive","value":"0000-0001-8363-9640"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Ghanbajad, Jaafar"},"contributorAffiliation":{"typeName":"contributorAffiliation","multiple":false,"typeClass":"primitive","value":"Université de Lorraine, CNRS, UL"},"contributorIdScheme":{"typeName":"contributorIdScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"contributorId":{"typeName":"contributorId","multiple":false,"typeClass":"primitive","value":"0000-0003-2870-0570"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Walcarius, Alain"},"contributorAffiliation":{"typeName":"contributorAffiliation","multiple":false,"typeClass":"primitive","value":"Université de Lorraine, CNRS, LCPME"},"contributorIdScheme":{"typeName":"contributorIdScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"contributorId":{"typeName":"contributorId","multiple":false,"typeClass":"primitive","value":"0000-0003-3633-200X"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Kąc, Małgorzata"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"The Henryk Niewodniczański Institute of Nuclear Physics Polish Academy of Sciences"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"malgorzata.kac@ifj.edu.pl"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"The repository contains raw data from cyclic voltammetry waveforms measured for single Fe, Co, Ni, and Cu salts and their mixtures (on a gold electrode and on a gold-coated PC membrane), as well as data on the dependence of the maximum cathodic current on the square root of the scan rate. It also includes measurements of the cathodic current and charge as a function of time for nanowires deposited at potentials ranging from -1.0 V to -1.8 V, along with their elemental composition and spatially resolved elemental distributions measured along individual nanowires. In addition, the repository provides results from X-ray and magnetic measurements, including hysteresis loops measured in two directions, switching-field distributions, saturation magnetization, coercivity, squareness, maximum switching field, and the dependence of the switching-field distribution on the cathodic potential. Angular measurements are also included, comprising fragments of the hysteresis loop recorded at different angles of the applied magnetic field, as well as experimental curves showing the dependence of coercivity on the angle between the magnetic field direction and the nanowire axis.\n\nThe associated paper describes the effect of Cu addition on FeCoNi nanowires, with particular emphasis on their crystallographic structure, phase distribution, magnetic properties, and magnetization reversal mechanisms."}}]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"nanowires"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"FeCoNiCu alloys"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"electrodeposition"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"magnetic properties"}}]},{"typeName":"mein2023","multiple":true,"typeClass":"compound","value":[{"subjectField":{"typeName":"subjectField","multiple":false,"typeClass":"controlledVocabulary","value":"77"}}]},{"typeName":"oecd","multiple":true,"typeClass":"compound","value":[{"oecdList":{"typeName":"oecdList","multiple":false,"typeClass":"controlledVocabulary","value":"13"}}]},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"controlledVocabulary","value":"Relation1"},"publicationAuthor":{"typeName":"publicationAuthor","multiple":false,"typeClass":"primitive","value":"Anna Nykiela, Wojciech Maziarz, Jaafar Ghanbaja, Alain Walcarius, Malgorzata Kac"},"publicationTitle":{"typeName":"publicationTitle","multiple":false,"typeClass":"primitive","value":"Cu-induced modifications of the morphological, chemical, structural, and magnetic properties of FeCoNi nanowires"}}]},{"typeName":"languageMain","multiple":true,"typeClass":"compound","value":[{"language":{"typeName":"language","multiple":false,"typeClass":"controlledVocabulary","value":"English"}}]},{"typeName":"funding","multiple":true,"typeClass":"compound","value":[{"fundingAgency":{"typeName":"fundingAgency","multiple":false,"typeClass":"controlledVocabulary","value":"National Science Center (NCN)"},"fundingName":{"typeName":"fundingName","multiple":false,"typeClass":"primitive","value":"Wpływ dodatku diamagnetycznej miedzi na właściwości magnetycznych nanodrutów FeCoNi i ich potencjał aplikacyjny w nanoelektronice"},"fundingID":{"typeName":"fundingID","multiple":false,"typeClass":"primitive","value":"2025/09/X/ST5/00121"},"grantInfo":{"typeName":"grantInfo","multiple":false,"typeClass":"primitive","value":"https://ror.org/03ha2q922"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Kąc, Małgorzata"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2026-05-05"},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"2022"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"2026"}}]},{"typeName":"kindOfDataMain","multiple":true,"typeClass":"compound","value":[{"kindOfData":{"typeName":"kindOfData","multiple":false,"typeClass":"controlledVocabulary","value":"Databases (content)"}}]}]}},"files":[{"label":"00_readme_MK.txt","restricted":false,"version":2,"datasetVersionId":111,"dataFile":{"id":630,"persistentId":"","filename":"00_readme_MK.txt","contentType":"text/plain","friendlyType":"Plain Text","filesize":2826,"storageIdentifier":"s3://ifjrodbukdata:19dfd085f76-4115dc1fc949","rootDataFileId":-1,"md5":"25c120932ba100b5474d37008bcfcb03","checksum":{"type":"MD5","value":"25c120932ba100b5474d37008bcfcb03"},"tabularData":false,"creationDate":"2026-05-06","publicat