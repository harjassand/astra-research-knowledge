{"files": [{"id": 52372281, "name": "oc4c01765_si_001.pdf", "size": 19390252, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/52372281", "supplied_md5": "d7e8410aeee351ed7ca0897e42fab8bd", "computed_md5": "d7e8410aeee351ed7ca0897e42fab8bd", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 14069270, "full_name": "Christopher\nA. Sojdak", "first_name": "Christopher\nA.", "last_name": "Sojdak", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20726871, "full_name": "David A. Polefrone", "first_name": "David A.", "last_name": "Polefrone", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20726874, "full_name": "Hriday M. Shah", "first_name": "Hriday M.", "last_name": "Shah", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20726877, "full_name": "Cassandra D. Vu", "first_name": "Cassandra D.", "last_name": "Vu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 13806083, "full_name": "Brandon J. Orzolek", "first_name": "Brandon J.", "last_name": "Orzolek", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20726880, "full_name": "Pedro M. Jimenez Antenucci", "first_name": "Pedro M.", "last_name": "Jimenez Antenucci", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 20726883, "full_name": "Micah Valadez Bush", "first_name": "Micah Valadez", "last_name": "Bush", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1314135, "full_name": "Marisa C. Kozlowski", "first_name": "Marisa C.", "last_name": "Kozlowski", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Direct_LC-_MS_Identification_of_Regioisomers_from_C_H_Functionalization_by_Partial_Isotopic_Labeling/28418706", "download_disabled": false, "description": "C\u2013H functionalization\nof complex substrates is highly enabling\nin total synthesis and in the development of late-stage drug candidates.\nMuch work has been dedicated to developing new methods as well as\npredictive modeling to accelerate route scouting. However, workflows\nto identify regioisomeric products are arduous, typically requiring\nchromatographic separation and/or nuclear magnetic resonance spectroscopy\nanalysis. In addition, most reports focus on major products or do\nnot assign regioisomeric products, which biases predictive models\nconstructed from such data. Herein, we present a novel approach to\ncomplex reaction analysis utilizing partial deuterium labels, which\nenables direct product identification via liquid chromatography\u2013mass\nspectrometry. When combined with spectral deconvolution, the method\ngenerates product ratios while circumventing chromatography altogether.\nCompetitive kinetic isotope effects can also be determined. The resultant\ndata are expected to be useful in the construction of predictive models\nacross several dimensions including reaction selectivity, the impact\nof structure on mechanism, and mass spectral ionization patterns and\nexpedite the identification of drug metabolites.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 19390252, "created_date": "2025-02-14T17:41:23Z", "modified_date": "2025-02-26T08:36:24Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["developing new methods", "circumventing chromatography altogether", "accelerate route scouting", "identify regioisomeric products", "assign regioisomeric products", "stage drug candidates", "major products", "drug metabolites", "total synthesis", "spectral deconvolution", "reports focus", "predictive modeling", "novel approach", "much work", "highly enabling", "complex substrates"], "keywords": ["developing new methods", "circumventing chromatography altogether", "a