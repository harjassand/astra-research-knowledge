{"files": [{"id": 65650732, "name": "ja6c05959_si_001.pdf", "size": 7450297, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/65650732", "supplied_md5": "653b2bd22993e1a98f9332847884081e", "computed_md5": "653b2bd22993e1a98f9332847884081e", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 11449924, "full_name": "Jayabrata Das", "first_name": "Jayabrata", "last_name": "Das", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 460267, "full_name": "Xueying Zhang", "first_name": "Xueying", "last_name": "Zhang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 346135, "full_name": "Ying Tan", "first_name": "Ying", "last_name": "Tan", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 24232231, "full_name": "Mohamed Abdelalim", "first_name": "Mohamed", "last_name": "Abdelalim", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 5787833, "full_name": "Taige Lu", "first_name": "Taige", "last_name": "Lu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 24232234, "full_name": "Carl Mauro", "first_name": "Carl", "last_name": "Mauro", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3865003, "full_name": "Clinton J. Regan", "first_name": "Clinton J.", "last_name": "Regan", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3808213, "full_name": "Tim Cernak", "first_name": "Tim", "last_name": "Cernak", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/A_50_688-Reaction_Data_Set_Reveals_General_Ligands_and_Mechanistic_Diversity_in_C_N_Couplings/32718736", "download_disabled": false, "description": "Transition metal catalyzed reactions enable the synthesis\nof medicines,\nmaterials, and agrochemicals. However, the discovery of such reactions\ntoday requires extensive experimentation, as contemporary machine\nlearning models cannot predict reaction outcomes without comprehensive\ntraining data. Robust out-of-sample predictions that could transfer\nbetween data sets remain challenging because control data, where only\na single parameter or reaction recipe component is altered, is rarely\navailable. Furthermore, contemporary models typically assume a single\nreaction mechanism while real-world catalytic systems may be more\nnuanced and operate by multiple competing mechanisms. Here, we present\na data set of over 50,000 systematically varied C\u2013N coupling\nreactions, built to maximize overlap across palladium-, nickel-, and\ncopper-catalyzed conditions. This enables direct comparison between\ncatalyst classes and data-driven benchmarking that has not been previously\npossible. We discovered ligands that exhibit generalized performance\nfor all three of these metals. Interestingly, metal-free control reactions\nreveal that multiple mechanistic pathways occur under nominally similar\nreaction conditions, including an aryne-based mechanism that is likely\nmore common in C\u2013N couplings than earlier appreciated. Common\ntask assignments are included for community benchmarking toward improved\ncomputational model development.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 7450297, "created_date": "2026-06-17T17:33:59Z", "modified_date": "2026-06-17T17:33:59Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["reaction recipe component", "multiple competing mechanisms", "exhibit generalized performance", "enables direct comparison", "single reaction mechanism", "common task assignments", "single parameter", "based mechanism", "sample predictions", "rarely available", "previously possible", "mechanistic diversity", "earlier appreciated", "driven benchmarking", "discovered ligands", "could transfer", "catalyzed conditions", "catalyst classes"], "keywords": ["reaction recipe component", "multiple competing mechanisms", "exhibit generalized performance", "enables direct comparison", "single reaction mechanism", "common task assignments", "single parameter", "based mechanism", "sample predictions", "rarely available", "previously possible", "mechanistic diversity", "earlier appreciated", "driven benchmarking", "discovered ligands", "could transfer", "catalyzed conditions", "catalyst classes"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 7, "title": "Medicine", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 14, "title": "Molecular Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 931, "title": "Information Systems not elsewhere classified", "parent_id": 52, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1021/jacs.6c05959"], "has_linked_file": false, "citation": "Das, Jayabrata; Zhang, Xueying; Tan, Ying; Abdelalim, Mohamed; Lu, Taige; Mauro, Carl; et al. (2026). A 50,688-Reaction Data\nSet Reveals General Ligands\nand Mechanistic Diversity in C\u2013N Couplings. ACS Publications. Journal contribution. https://doi.org/10.1021/jacs.6c05959.s001", "related_materials": [{"id": 280395547, "identifier": "10.1021/jacs.6c05959", "title": "A 50,688-Reaction Data\nSet Reveals General Ligands\nand Mechanistic Diversity in C\u2013N Couplings", 