+    errors=[]; relative=[]; nonreal=[]; minimum=[]
+    for seed in range(8):
+        f0,a,H,physical=dissipative_plant(32,seed)
+        oracle=ScalarOracle(f0,a,H,noise,1000+seed)
+        fh,ah,Hh,info=acquire(32,oracle,t1=1.,t2=2.,t3=1.)
