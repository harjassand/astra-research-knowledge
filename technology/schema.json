{
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "previous",
    "fixture",
    "disclosure",
    "domain",
    "stage",
    "disposition",
    "capability",
    "assessment",
    "refs",
    "next_obligation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "astra-technology/1"},
    "id": {"type": "string", "pattern": "T-[a-z0-9][a-z0-9-]{0,76}"},
    "version": {"type": "integer", "minimum": 1},
    "previous": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "fixture": {"type": "boolean"},
    "disclosure": {"type": "string", "const": "public"},
    "domain": {"type": "string", "enum": ["software", "physical", "hybrid"]},
    "stage": {
      "type": "string",
      "enum": ["opportunity", "mechanism", "model", "simulation", "experiment", "prototype", "scaling"]
    },
    "disposition": {"type": "string", "enum": ["active", "paused", "abandoned"]},
    "capability": {
      "type": "object",
      "required": ["problem", "current_best", "limitation", "proposed_mechanism", "baseline_ref_ids", "target"],
      "additionalProperties": false,
      "properties": {
        "problem": {"type": "string", "minLength": 1},
        "current_best": {"type": "string", "minLength": 1},
        "limitation": {"type": "string", "minLength": 1},
        "proposed_mechanism": {"type": "string", "minLength": 1},
        "baseline_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "target": {
          "type": "object",
          "required": ["metric", "baseline", "desired", "unit", "conditions", "comparator"],
          "additionalProperties": false,
          "properties": {
            "metric": {"type": "string", "minLength": 1},
            "baseline": {"anyOf": [{"type": "number"}, {"type": "null"}]},
            "desired": {"anyOf": [{"type": "number"}, {"type": "null"}]},
            "unit": {"type": "string", "minLength": 1},
            "conditions": {"type": "string", "minLength": 1},
            "comparator": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": ["potential_significance", "scientific_evidence", "feasibility_and_readiness", "next_step_value"],
      "additionalProperties": false,
      "properties": {
        "potential_significance": {"$ref": "#/$defs/assessment"},
        "scientific_evidence": {"$ref": "#/$defs/assessment"},
        "feasibility_and_readiness": {"$ref": "#/$defs/assessment"},
        "next_step_value": {"$ref": "#/$defs/assessment"}
      }
    },
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 0},
    "next_obligation": {"type": "string", "minLength": 1},
    "contract": {"$ref": "#/$defs/contract"},
    "scaling": {"$ref": "#/$defs/scaling"},
    "bridges": {"type": "array", "items": {"$ref": "#/$defs/bridge"}, "minItems": 0},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}, "minItems": 0},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 0},
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}, "minItems": 0},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}, "minItems": 0},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}, "minItems": 0}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["id", "path", "sha256", "lines", "source_revision", "source_id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "lines": {
          "anyOf": [
            {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
            {"type": "null"}
          ]
        },
        "source_revision": {"anyOf": [{"type": "string", "pattern": "[0-9a-f]{40}"}, {"type": "null"}]},
        "source_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "interface": {
      "type": "object",
      "required": [
        "objects",
        "regime_and_quantifiers",
        "supplied_information",
        "acquired_information",
        "legal_access",
        "guarantee",
        "units_norm_and_precision",
        "costs"
      ],
      "additionalProperties": false,
      "properties": {
        "objects": {"type": "string", "minLength": 1},
        "regime_and_quantifiers": {"type": "string", "minLength": 1},
        "supplied_information": {"type": "string", "minLength": 1},
        "acquired_information": {"type": "string", "minLength": 1},
        "legal_access": {"type": "string", "minLength": 1},
        "guarantee": {"type": "string", "minLength": 1},
        "units_norm_and_precision": {"type": "string", "minLength": 1},
        "costs": {"type": "string", "minLength": 1}
      }
    },
    "assessment": {
      "type": "object",
      "required": ["judgement", "basis_ref_ids", "limits"],
      "additionalProperties": false,
      "properties": {
        "judgement": {"type": "string", "minLength": 1},
        "basis_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "limits": {"type": "string", "minLength": 1}
      }
    },
    "experiment": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "prediction",
        "equipment_or_data",
        "controls",
        "expected_signal",
        "uncertainty",
        "estimated_cost",
        "invalidates",
        "procedure",
        "acceptance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
        "kind": {"type": "string", "enum": ["simulation", "software_benchmark", "laboratory", "system"]},
        "prediction": {"type": "string", "minLength": 1},
        "equipment_or_data": {"type": "string", "minLength": 1},
        "controls": {"type": "string", "minLength": 1},
        "expected_signal": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "estimated_cost": {"type": "string", "minLength": 1},
        "invalidates": {"type": "string", "minLength": 1},
        "procedure": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "result",
        "environment",
        "scope",
        "producer",
        "method",
        "ref_ids",
        "subject_ref_ids",
        "experiment_id",
        "independence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
        "kind": {
          "type": "string",
          "enum": [
            "hypothesis",
            "theoretical_derivation",
            "simulation",
            "reproduced_simulation",
            "independent_computational_test",
            "experimental_measurement",
            "validated_prototype",
            "demonstrated_system"
          ]
        },
        "result": {"type": "string", "enum": ["passed", "failed", "unknown"]},
        "environment": {"type": "string", "enum": ["software", "physical", "abstract"]},
        "scope": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 1,
          "uniqueItems": true
        },
        "subject_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "experiment_id": {"anyOf": [{"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"}, {"type": "null"}]},
        "independence": {
          "type": "object",
          "required": ["attested", "relationship", "basis_ref_ids"],
          "additionalProperties": false,
          "properties": {
            "attested": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
            "relationship": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
            "basis_ref_ids": {
              "type": "array",
              "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
              "minItems": 0,
              "uniqueItems": true
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quantity", "value", "unit", "uncertainty", "conditions"],
            "additionalProperties": false,
            "properties": {
              "quantity": {"type": "string", "minLength": 1},
              "value": {"type": "number"},
              "unit": {"type": "string", "minLength": 1},
              "uncertainty": {"type": "number", "minimum": 0},
              "conditions": {"type": "string", "minLength": 1}
            }
          },
          "minItems": 1
        }
      }
    },
    "bridge": {
      "type": "object",
      "required": [
        "id",
        "state",
        "source_card_ids",
        "source_gate_ids",
        "source_ref_ids",
        "source_established",
        "source_interface",
        "destination_interface",
        "capability_consequence",
        "implementation",
        "missing_operations",
        "resource_feasibility",
        "validation_experiment_ids",
        "proof_ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
        "state": {
          "type": "string",
          "enum": [
            "PROVEN LOGICAL DEPENDENCY",
            "ESTABLISHED COMPATIBLE INTERFACE",
            "CANDIDATE CONNECTION",
            "INCOMPATIBLE ASSUMPTIONS",
            "REFUTED TRANSFER"
          ]
        },
        "source_card_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "source_gate_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "source_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 1,
          "uniqueItems": true
        },
        "source_established": {"type": "string", "minLength": 1},
        "source_interface": {"$ref": "#/$defs/interface"},
        "destination_interface": {"$ref": "#/$defs/interface"},
        "capability_consequence": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "missing_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0},
        "resource_feasibility": {"type": "string", "minLength": 1},
        "validation_experiment_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 1,
          "uniqueItems": true
        },
        "proof_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "id",
        "direction",
        "destination_role",
        "obstruction",
        "requested_capability",
        "input_interface",
        "acceptance_experiment_ids",
        "source_ref_ids",
        "checkpoint_path",
        "decision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
        "direction": {"type": "string", "enum": ["forward", "reverse"]},
        "destination_role": {"type": "string", "minLength": 1},
        "obstruction": {"type": "string", "minLength": 1},
        "requested_capability": {"type": "string", "minLength": 1},
        "input_interface": {"$ref": "#/$defs/interface"},
        "acceptance_experiment_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 1,
          "uniqueItems": true
        },
        "checkpoint_path": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "decision": {"type": "string", "enum": ["pending", "accepted", "declined"]}
      }
    },
    "gate": {
      "type": "object",
      "required": ["stage", "decision", "evidence_ids", "rationale"],
      "additionalProperties": false,
      "properties": {
        "stage": {"type": "string", "enum": ["mechanism", "model", "simulation", "experiment", "prototype", "scaling"]},
        "decision": {"type": "string", "enum": ["open", "passed", "failed"]},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 0,
          "uniqueItems": true
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "failure": {
      "type": "object",
      "required": ["attempt", "failure_scope", "ref_ids"],
      "additionalProperties": false,
      "properties": {
        "attempt": {"type": "string", "minLength": 1},
        "failure_scope": {"type": "string", "minLength": 1},
        "ref_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,100}"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "governing_equations",
        "assumptions",
        "conservation_and_thermodynamics",
        "materials",
        "units_and_tolerances",
        "input_acquisition",
        "error_budget",
        "energy_balance",
        "reliability",
        "resources"
      ],
      "additionalProperties": false,
      "properties": {
        "governing_equations": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "conservation_and_thermodynamics": {"type": "string", "minLength": 1},
        "materials": {"type": "string", "minLength": 1},
        "units_and_tolerances": {"type": "string", "minLength": 1},
        "input_acquisition": {"type": "string", "minLength": 1},
        "error_budget": {"type": "string", "minLength": 1},
        "energy_balance": {"type": "string", "minLength": 1},
        "reliability": {"type": "string", "minLength": 1},
        "resources": {"type": "string", "minLength": 1}
      }
    },
    "scaling": {
      "type": "object",
      "required": [
        "manufacturability",
        "supply_chain",
        "energy_and_materials",
        "economic_comparator",
        "maintenance",
        "environmental_constraints",
        "scaling_limits"
      ],
      "additionalProperties": false,
      "properties": {
        "manufacturability": {"type": "string", "minLength": 1},
        "supply_chain": {"type": "string", "minLength": 1},
        "energy_and_materials": {"type": "string", "minLength": 1},
        "economic_comparator": {"type": "string", "minLength": 1},
        "maintenance": {"type": "string", "minLength": 1},
        "environmental_constraints": {"type": "string", "minLength": 1},
        "scaling_limits": {"type": "string", "minLength": 1}
      }
    }
  },
  "description": "Public bookkeeping schema; validate.py adds evidence, lineage and stage constraints. It cannot certify science."
}
