frontier/dossiers/** linguist-generated=true
frontier/connections/** linguist-generated=true
# Exact historical payloads retain source trailing spaces and final blank lines.
frontier/proof_ranges/** linguist-generated=true whitespace=-blank-at-eol,-blank-at-eof
frontier/gates/** linguist-generated=true
frontier/blockers/** linguist-generated=true
mechanisms/bridges/** linguist-generated=true
agent/concepts/** linguist-generated=true
agent/access_manifest.json linguist-generated=true
agent/manifest.json linguist-generated=true
# BR scientific originals retain exact line endings, Markdown spaces and receipts.
updates/BR/package/** -text whitespace=-blank-at-eol,-blank-at-eof
# BS and BT source archives and attached records retain their original bytes.
updates/BS/package/** -text whitespace=-blank-at-eol,-blank-at-eof
updates/BT/package/** -text whitespace=-blank-at-eol,-blank-at-eof
# Primitive Genesis originals and the conversational source summary are byte-preserved.
updates/BU/package/** -text whitespace=-blank-at-eol,-blank-at-eof
updates/BU/PRESENTED_SUMMARY.txt -text whitespace=-blank-at-eol,-blank-at-eof
# Generated web mirrors preserve source Markdown whitespace inside escaped text.
web/pages/*.html linguist-generated=true whitespace=-blank-at-eol,-blank-at-eof
